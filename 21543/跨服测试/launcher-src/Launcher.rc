    EDITTEXT        IDC_EDITPWD,7,50,243,14,ES_PASSWORD | ES_AUTOHSCROLL
    LTEXT           "CDK",IDC_TEXTUN2,7,66,177,8
    EDITTEXT        IDC_EDIT1,7,75,243,14,ES_AUTOHSCROLL
    DEFPUSHBUTTON   "Register Account",IDOK,7,121,243,16
    LTEXT           "Invite Code",IDC_TEXTUN3,7,91,177,8
    EDITTEXT        IDC_EDIT2,7,103,243,14,ES_AUTOHSCROLL
END


