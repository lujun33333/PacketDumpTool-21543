/////////////////////////////////////////////////////////////////////////////
//
// Dialog
//

IDD_LOGIN DIALOGEX 0, 0, 461, 237
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Launcher"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    EDITTEXT        IDC_EDITUN,159,217,70,12,ES_AUTOHSCROLL
    EDITTEXT        IDC_EDITPWD,235,217,70,12,ES_PASSWORD | ES_AUTOHSCROLL
    LTEXT           "Account",IDC_TEXTUN,160,206,36,8
    LTEXT           "Password",IDC_TEXTPWD,236,206,46,8
    PUSHBUTTON      "Login",IDOK,312,205,60,25
    PUSHBUTTON      "Register",IDC_BUTTONREGISTER,377,205,59,25
    CONTROL         "32-bit",IDC_RADIO1,"Button",BS_AUTORADIOBUTTON | BS_FLAT | NOT WS_VISIBLE,15,135,36,10,WS_EX_TRANSPARENT
    CONTROL         "64-bit",IDC_RADIO2,"Button",BS_AUTORADIOBUTTON | NOT WS_VISIBLE,16,121,36,10,WS_EX_TRANSPARENT
    PUSHBUTTON      "Restore",IDC_EDIT1,7,103,44,14,NOT WS_VISIBLE
    COMBOBOX        IDC_COMBO1,7,150,70,30,CBS_DROPDOWN | NOT WS_VISIBLE | WS_VSCROLL | WS_TABSTOP
    LTEXT           "Bitness",IDC_TEXTUN2,7,80,36,8,NOT WS_VISIBLE
END

IDD_REGISTER DIALOGEX 0, 0, 257, 144
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Register"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
