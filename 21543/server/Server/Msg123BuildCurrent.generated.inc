// END CURRENT PADDING ALIASES
class Reader
{
public:
    Reader(const Byte* data, std::size_t size, std::string* error,
           std::size_t start = 0,
           bool allowUnknownCountZero = false,
           bool allowShiftedPadding = false)
        : data_(data), size_(size), position_(start), error_(error),
          allowUnknownCountZero_(allowUnknownCountZero),
          allowShiftedPadding_(allowShiftedPadding) {}
    std::size_t Position() const { return position_; }
    bool AtEnd() const { return position_ == size_; }
    bool Fail(const char* reason)
    {
        if (error_)
            *error_ = std::string("msg123/21669 ") + reason +
                " at safe offset " + std::to_string(position_);
        return false;
    }
    bool Take(Byte& value)
    {
        if (position_ >= size_) return Fail("is truncated");
        value = data_[position_++];
        return true;
    }
    bool ReadByte(const DecodeTable& table, std::uint64_t& value)
    {
        Byte encoded = 0;
        if (!Take(encoded)) return false;
        value = table[encoded];
        return true;
    }
    bool ReadVar(const DecodeTable& table, unsigned int bits, std::uint64_t& value, const char* field)
    {
        if (bits == 0 || bits > 64) return Fail("has invalid varint width");
        value = 0;
        const unsigned int maxBytes = (bits + 6u) / 7u;
        for (unsigned int index = 0; index < maxBytes; ++index)
        {
            Byte encoded = 0;
            if (!Take(encoded)) return false;
            const Byte raw = table[encoded];
            const std::uint64_t payload = raw & 0x7Fu;
            const unsigned int shift = index * 7u;
            const unsigned int remaining = bits > shift ? bits - shift : 0;
            if (remaining < 7u && remaining != 0 && (payload >> remaining) != 0)
                return Fail((std::string(field) + " varint overflows width").c_str());
            value |= payload << shift;
            if ((raw & 0x80u) == 0)
            {
                if (index != 0 && payload == 0)
                    return Fail((std::string(field) + " uses non-canonical varint").c_str());
                return true;
            }
        }
        return Fail((std::string(field) + " varint is too long").c_str());
    }
    template <std::size_t N>
    bool ReadCode(const std::array<Code, N>& codes, std::uint32_t& value, const char* field)
    {
        if (strcmp(field, "count16") == 0 ||
            strcmp(field, "count18") == 0)
        {
            if (position_ >= size_) return Fail("has truncated fixed-nine count");
            ++position_;
            value = 9;
            return true;
        }
        if (strcmp(field, "count15") == 0)
        {
            if (position_ >= size_) return Fail("has truncated fixed-track count");
            ++position_;
            value = 224;
            return true;
        }
        if (strcmp(field, "count17") == 0)
        {
            if (position_ >= size_) return Fail("has truncated fixed-zero count");
            ++position_;
            value = 0;
            return true;
        }
        const Code* match = nullptr;
        for (const Code& code : codes)
        {
            if (position_ + code.length > size_) continue;
            if (data_[position_] != code.first) continue;
            if (code.length == 2 && data_[position_ + 1] != code.second) continue;
            if (!match || code.length > match->length) match = &code;
        }
        if (!match)
        {
            // The recovered full grammar remains strict.  The bounded suffix
            // scanner can accept an unknown one-byte code only as zero, then
            // validates the complete gameplay tail and recipient UIN.
            if (allowUnknownCountZero_ && position_ < size_)
            {
                ++position_;
                value = 0;
                return true;
            }
            if (error_)
                *error_ = std::string("msg123/current ") + field + " unknown count code byte=" +
                    std::to_string(position_ < size_ ? data_[position_] : 0) +
                    " choices=" + std::to_string(N) +
                    " at safe offset " + std::to_string(position_);
            return false;
        }
        position_ += match->length;
        value = match->value;
        return true;
    }
    template <std::size_t N>
    bool ReadPadding(const std::array<Code, N>& codes, Byte marker, unsigned int site)
    {
        // Padding count codes are session-derived in the current client, while
        // the following marker run remains self-delimiting. Consume the code
        // byte and derive the dynamic count from the run itself.
        (void)codes;
        (void)marker;
        (void)site;
        lastPaddingShifted_ = false;
        Byte encodedCount = 0;
        if (!Take(encodedCount)) return false;
        if (position_ >= size_) return Fail("has truncated padding");
        const Byte actualMarker = data_[position_];
        std::uint32_t count = 0;
        while (count < 64 && position_ + count < size_ &&
               data_[position_ + count] == actualMarker)
            ++count;
        if (count == 0) return Fail("has invalid padding marker");
        if ((site == 17U || allowShiftedPadding_) &&
            count == 1 && position_ + 2 < size_)
        {
            const Byte shiftedMarker = data_[position_ + 1];
            std::uint32_t shiftedCount = 0;
            while (shiftedCount < 64 &&
                   position_ + 1 + shiftedCount < size_ &&
                   data_[position_ + 1 + shiftedCount] == shiftedMarker)
                ++shiftedCount;
            if (shiftedCount >= 3)
            {
                position_ += 1 + shiftedCount;
                lastPaddingShifted_ = true;
                return true;
            }
        }
        position_ += count;
        return true;
    }
    bool ReadUnshiftedPaddingGap()
    {
        if (lastPaddingShifted_)
        {
            lastPaddingShifted_ = false;
            return true;
        }
        Byte ignored = 0;
        return Take(ignored);
    }
    bool ReadConst(Byte expected)
    {
        // Bytes not backed by a discovered plain-object field may be
        // session-derived in production. They still occupy one byte,
        // so consume them without pinning the oracle's zero-state value.
        (void)expected;
        Byte actual = 0;
        return Take(actual);
    }
    bool SkipOpaque(std::size_t count)
    {
        if (count > size_ - position_)
            return Fail("has truncated opaque block");
        position_ += count;
        return true;
    }
    bool SkipCurrentTrackOpaque()
    {
        return SkipOpaque(lastPaddingShifted_ ? 242U : 253U);
    }
    bool SeekRepeated(Byte value, std::size_t count)
    {
        if (count == 0) return true;
        for (std::size_t candidate = position_;
             candidate + count <= size_ && candidate - position_ <= 1024;
             ++candidate)
        {
            std::size_t matched = 0;
            while (matched < count && data_[candidate + matched] == value)
                ++matched;
            if (matched == count)
            {
                position_ = candidate;
                return true;
            }
        }
        return Fail("cannot locate telemetry array anchor");
    }
private:
    const Byte* data_ = nullptr;
    std::size_t size_ = 0;
    std::size_t position_ = 0;
    std::string* error_ = nullptr;
    bool lastPaddingShifted_ = false;
    bool allowUnknownCountZero_ = false;
    bool allowShiftedPadding_ = false;
};

