struct TraceView { const Operation* data; std::size_t size; };
template <std::size_t N>
TraceView View(const std::array<Operation, N>& operations) {
    return { operations.data(), operations.size() };
}
bool SelectTrace(
    const std::uint8_t* raw,
    std::size_t rawSize,
    TraceView& trace,
    std::string* error) {
    if (!raw || rawSize < 0xA7C4U) {
        if (error) *error = "current Msg509 fixed object is truncated";
        return false;
    }
    const auto readU16 = [raw](std::size_t offset) {
        return static_cast<std::uint16_t>(raw[offset]) |
            static_cast<std::uint16_t>(raw[offset + 1]) << 8U;
    };
    const std::size_t players = raw[0x796U];
    const std::uint16_t baseMode = readU16(0x8E65U);
    const std::uint16_t subMode = readU16(0x8E67U);
    const std::size_t anonymousCount = raw[0x9B0DU];
    if (baseMode == 10U && subMode == 1U && players == 1U) {
        trace = View(kTraceCarGod1);
        return true;
    }
    if (baseMode == 42U && subMode == 29U && players == 1U) {
        trace = View(kTraceAurora1);
        return true;
    }
    if (baseMode == 42U && subMode == 27U) {
        switch (players) {
        case 1U: trace = View(kTraceCustom1); return true;
        case 2U: trace = View(kTraceCustom2); return true;
        case 3U: trace = View(kTraceCustom3); return true;
        case 4U: trace = View(kTraceCustom4); return true;
        case 5U: trace = View(kTraceCustom5); return true;
        case 6U: trace = View(kTraceCustom6); return true;
        case 7U: trace = View(kTraceCustom7); return true;
        case 8U: trace = View(kTraceCustom8); return true;
        case 9U: trace = View(kTraceCustom9); return true;
        case 10U: trace = View(kTraceCustom10); return true;
        case 11U: trace = View(kTraceCustom11); return true;
        case 12U: trace = View(kTraceCustom12); return true;
        default: break;
        }
    }
    if (baseMode == 40U && subMode == 1U) {
        switch (players) {
        case 1U: trace = View(kTraceRanked1); return true;
        case 2U: trace = View(kTraceRanked2); return true;
        case 3U: trace = View(kTraceRanked3); return true;
        case 4U: trace = View(kTraceRanked4); return true;
        case 5U: trace = View(kTraceRanked5); return true;
        case 6U: trace = View(kTraceRanked6); return true;
        default: break;
        }
    }
    if (baseMode == 1U && subMode == 1U) {
        if (anonymousCount != 0U) {
            if (anonymousCount != players) {
                if (error) *error = "current Msg509 anonymous/player count mismatch";
                return false;
            }
            switch (players) {
            case 1U: trace = View(kTraceNormalAnonymous1); return true;
            case 2U: trace = View(kTraceNormalAnonymous2); return true;
            case 3U: trace = View(kTraceNormalAnonymous3); return true;
            case 4U: trace = View(kTraceNormalAnonymous4); return true;
            case 5U: trace = View(kTraceNormalAnonymous5); return true;
            case 6U: trace = View(kTraceNormalAnonymous6); return true;
            default: break;
            }
        } else if (raw[0x74BU] != 0U) {
            switch (players) {
            case 1U: trace = View(kTraceNormalCurrent1); return true;
            case 2U: trace = View(kTraceNormalCurrent2); return true;
            case 3U: trace = View(kTraceNormalCurrent3); return true;
            case 4U: trace = View(kTraceNormalCurrent4); return true;
            case 5U: trace = View(kTraceNormalCurrent5); return true;
            case 6U: trace = View(kTraceNormalCurrent6); return true;
            default: break;
            }
        } else {
            switch (players) {
            case 1U: trace = View(kTraceBorder1); return true;
            case 2U: trace = View(kTraceBorder2); return true;
            case 3U: trace = View(kTraceBorder3); return true;
            case 4U: trace = View(kTraceBorder4); return true;
            case 5U: trace = View(kTraceBorder5); return true;
            case 6U: trace = View(kTraceBorder6); return true;
            default: break;
            }
        }
    }
    if (error) *error = "unsupported current Msg509 mode/player profile";
    return false;
}
std::uint64_t ReadValue(
    const std::uint8_t* raw,
    std::size_t rawSize,
    const Operation& operation) {
    if (operation.rawOffset == kConstantZero) return 0U;
    std::uint64_t value = 0U;
    for (std::size_t index = 0; index < operation.size; ++index) {
        const std::size_t offset =
            static_cast<std::size_t>(operation.rawOffset) + index;
        if (offset < rawSize)
            value |= static_cast<std::uint64_t>(raw[offset]) << (index * 8U);
    }
    return value;
}
bool EmitOperation(
    const std::uint8_t* raw,
    std::size_t rawSize,
    const Operation& operation,
    std::vector<std::uint8_t>& out,
    std::string* error) {
    const CodecTable& codec = kCodecTables[operation.codec];
    std::uint64_t value = ReadValue(raw, rawSize, operation);
    if (codec.kind == CodecKind::Direct) {
        if (value > 0xFFU) {
            if (error) *error = "21669 Msg509 direct field exceeds one byte";
            return false;
        }
        out.push_back(codec.inverse[static_cast<std::uint8_t>(value)]);
        return true;
    }
    do {
        std::uint8_t token = static_cast<std::uint8_t>(value & 0x7FU);
        value >>= 7U;
        if (value != 0U) token |= 0x80U;
        out.push_back(codec.inverse[token]);
    } while (value != 0U);
    return true;
}
