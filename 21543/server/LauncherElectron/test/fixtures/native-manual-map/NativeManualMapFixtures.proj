<?xml version="1.0" encoding="utf-8"?>
<Project DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <Configuration Condition="'$(Configuration)'==''">Release</Configuration>
    <Platform Condition="'$(Platform)'==''">x64</Platform>
    <NativeFixtureRoot Condition="'$(NativeFixtureRoot)'==''">$(TEMP)NativeManualMapFixture\</NativeFixtureRoot>
  </PropertyGroup>
  <ItemGroup>
    <NativeFixtureProject Include="$(MSBuildThisFileDirectory)NativeManualMapFixtureDll.vcxproj" />
    <NativeFixtureProject Include="$(MSBuildThisFileDirectory)NativeManualMapChild.vcxproj" />
    <NativeFixtureProject Include="$(MSBuildThisFileDirectory)NativeManualMapHarness.vcxproj" />
  </ItemGroup>
  <Target Name="Build">
    <MakeDir Directories="$(NativeFixtureRoot)out;$(NativeFixtureRoot)obj" />
    <MSBuild
      Projects="@(NativeFixtureProject)"
      BuildInParallel="true"
      Properties="Configuration=$(Configuration);Platform=$(Platform);NativeFixtureRoot=$(NativeFixtureRoot)" />
  </Target>
</Project>
