<Window x:Class="PacketDumpViewer.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:local="clr-namespace:PacketDumpViewer.App.Models"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        mc:Ignorable="d"
        Title="PacketDumpViewer.exe"
        Height="860"
        MinHeight="700"
        Width="1500"
        MinWidth="980"
        FontFamily="Microsoft YaHei UI"
        FontSize="12"
        Background="#ECEFF3">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#111827" />
            <Setter Property="FontSize" Value="12" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="Margin" Value="3,0" />
            <Setter Property="MinWidth" Value="66" />
            <Setter Property="MinHeight" Value="25" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Background" Value="#F2F4F7" />
            <Setter Property="Foreground" Value="#111827" />
            <Setter Property="BorderBrush" Value="#AEB7C4" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="5,3" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="MinHeight" Value="24" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#AEB7C4" />
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="MinHeight" Value="24" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#AEB7C4" />
        </Style>
        <Style TargetType="GroupBox">
            <Setter Property="Margin" Value="5" />
            <Setter Property="Padding" Value="6" />
            <Setter Property="Background" Value="#F9FAFB" />
            <Setter Property="BorderBrush" Value="#C2C9D3" />
            <Setter Property="FontSize" Value="12" />
        </Style>
        <Style TargetType="TabControl">
            <Setter Property="Background" Value="White" />
        </Style>
        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#9FB0C5" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="RowBackground" Value="White" />
            <Setter Property="AlternatingRowBackground" Value="#F7F9FC" />
            <Setter Property="HorizontalGridLinesBrush" Value="#D5DAE2" />
            <Setter Property="VerticalGridLinesBrush" Value="#E4E8EF" />
            <Setter Property="GridLinesVisibility" Value="All" />
            <Setter Property="HeadersVisibility" Value="Column" />
            <Setter Property="RowHeight" Value="22" />
            <Setter Property="ColumnHeaderHeight" Value="24" />
            <Setter Property="FontSize" Value="12" />
        </Style>
        <Style TargetType="{x:Type DataGridColumnHeader}">
            <Setter Property="Background" Value="#EEF2F7" />
            <Setter Property="Foreground" Value="#111827" />
            <Setter Property="BorderBrush" Value="#C7CFDA" />
            <Setter Property="BorderThickness" Value="0,0,1,1" />
            <Setter Property="Padding" Value="6,2" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style TargetType="{x:Type TreeViewItem}">
            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
        </Style>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>
        <Style x:Key="MonoText" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="FontSize" Value="12" />
        </Style>
        <Style x:Key="MutedText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#6B7280" />
            <Setter Property="FontSize" Value="11" />
        </Style>
        <HierarchicalDataTemplate DataType="{x:Type local:ParsedFieldNode}"
                                  ItemsSource="{Binding Children}">
            <StackPanel Orientation="Horizontal"
                        ToolTip="{Binding DisplayText}">
                <TextBlock Text="{Binding OffsetHex}"
                           FontFamily="Consolas"
                           FontSize="12"
                           Foreground="#2563EB" />
                <TextBlock Text="{Binding SizeText}"
                           FontFamily="Consolas"
                           FontSize="12"
                           Foreground="#64748B" />
                <TextBlock Text="{Binding TypeText}"
                           FontFamily="Consolas"
                           FontSize="12"
                           Foreground="#7C3AED" />
                <TextBlock Text="{Binding NameText}"
                           FontFamily="Consolas"
                           FontSize="12"
                           FontWeight="SemiBold"
                           Foreground="#111827" />
                <TextBlock Text="{Binding ValueText}"
                           FontFamily="Consolas"
                           FontSize="12"
                           Foreground="#15803D" />
                <Border x:Name="StatusBadge"
                        Background="#E5E7EB"
                        BorderBrush="#CBD5E1"
                        BorderThickness="1"
                        Padding="4,0"
                        Margin="6,0,0,0">
                    <TextBlock x:Name="StatusText"
                               Text="{Binding Status}"
                               FontFamily="Consolas"
                               FontSize="11"
                               Foreground="#374151" />
                </Border>
                <TextBlock Text="{Binding NoteText}"
                           FontFamily="Consolas"
                           FontSize="12"
                           Foreground="#B45309" />
            </StackPanel>
            <HierarchicalDataTemplate.Triggers>
                <DataTrigger Binding="{Binding Status}" Value="Verified">
                    <Setter TargetName="StatusBadge" Property="Background" Value="#DCFCE7" />
                    <Setter TargetName="StatusBadge" Property="BorderBrush" Value="#86EFAC" />
                    <Setter TargetName="StatusText" Property="Foreground" Value="#166534" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Dynamic">
                    <Setter TargetName="StatusBadge" Property="Background" Value="#DBEAFE" />
                    <Setter TargetName="StatusBadge" Property="BorderBrush" Value="#93C5FD" />
                    <Setter TargetName="StatusText" Property="Foreground" Value="#1D4ED8" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="SingleSample">
                    <Setter TargetName="StatusBadge" Property="Background" Value="#E0E7FF" />
                    <Setter TargetName="StatusBadge" Property="BorderBrush" Value="#A5B4FC" />
                    <Setter TargetName="StatusText" Property="Foreground" Value="#3730A3" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="UnknownName">
                    <Setter TargetName="StatusBadge" Property="Background" Value="#FEF3C7" />
                    <Setter TargetName="StatusBadge" Property="BorderBrush" Value="#FCD34D" />
                    <Setter TargetName="StatusText" Property="Foreground" Value="#92400E" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Unaligned">
                    <Setter TargetName="StatusBadge" Property="Background" Value="#FEE2E2" />
                    <Setter TargetName="StatusBadge" Property="BorderBrush" Value="#FCA5A5" />
                    <Setter TargetName="StatusText" Property="Foreground" Value="#991B1B" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Reserved">
                    <Setter TargetName="StatusBadge" Property="Background" Value="#F1F5F9" />
                    <Setter TargetName="StatusBadge" Property="BorderBrush" Value="#CBD5E1" />
                    <Setter TargetName="StatusText" Property="Foreground" Value="#475569" />
                </DataTrigger>
            </HierarchicalDataTemplate.Triggers>
        </HierarchicalDataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="#F8FAFC"
                BorderBrush="#C7CFDA"
                BorderThickness="0,0,0,1"
                Padding="12,7">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Left">
                    <TextBlock Text="PacketDumpViewer.exe"
                               Foreground="#111827"
                               FontSize="18"
                               FontWeight="Bold" />
                    <TextBlock Text="QQSpeed Packet Dump Viewer / QQ飞车封包转储查看器"
                               Foreground="#4B5563"
                               FontSize="11"
                               Margin="0,2,0,0" />
                </StackPanel>
                <StackPanel DockPanel.Dock="Right"
                            Orientation="Horizontal"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Right">
                    <Button Content="Dump查看"
                            Command="{Binding ShowDumpViewerCommand}" />
                    <Button Content="在线抓包解密"
                            Command="{Binding ShowWiresharkDecryptCommand}"
                            Background="#2563EB"
                            Foreground="White" />
                    <TextBlock Text="{Binding ActivePageTitle}"
                               Foreground="#374151"
                               VerticalAlignment="Center"
                               Margin="12,0,0,0" />
                    <TextBlock Text="v1.7"
                               Foreground="#6B7280"
                               VerticalAlignment="Center"
                               Margin="12,0,0,0" />
                </StackPanel>
            </DockPanel>
        </Border>

        <Border Grid.Row="1"
                Background="White"
                BorderBrush="#D1D5DB"
                BorderThickness="0,0,0,1"
                Padding="12"
                Visibility="{Binding IsDumpViewerPageVisible, Converter={StaticResource BoolToVisibilityConverter}}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="Dump目录:" VerticalAlignment="Center" Margin="0,0,8,0" />
                <TextBox Grid.Row="0"
                         Grid.Column="1"
                         Text="{Binding DumpDirectory, UpdateSourceTrigger=PropertyChanged}"
                         FontFamily="Consolas" />
                <StackPanel Grid.Row="0" Grid.Column="2" Orientation="Horizontal" Margin="8,0,0,0">
                    <Button Content="选择目录" Command="{Binding ChooseDirectoryCommand}" />
                    <Button Content="重新扫描" Command="{Binding RescanCommand}" />
                    <Button Content="打开payload目录" Command="{Binding OpenPayloadDirectoryCommand}" />
                    <Button Content="复制文件路径" Command="{Binding CopyFilePathCommand}" />
                </StackPanel>

                <TextBlock Grid.Row="1" Grid.Column="0" Text="搜索:" VerticalAlignment="Center" Margin="0,10,8,0" />
                <TextBox Grid.Row="1"
                         Grid.Column="1"
                         Margin="0,10,0,0"
                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="MsgID / direction / seq / filename" />
                <TextBlock Grid.Row="1"
                           Grid.Column="2"
                           Margin="12,10,4,0"
                           VerticalAlignment="Center"
                           Text="{Binding LogStatusText}" />

                <TextBlock Grid.Row="2" Grid.Column="0" Text="翻译:" VerticalAlignment="Center" Margin="0,10,8,0" />
                <Grid Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="160" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ComboBox x:Name="TranslateSiteCombo"
                              Grid.Column="0"
                              SelectedIndex="0"
                              VerticalContentAlignment="Center"
                              Margin="0,0,8,0">
                        <ComboBoxItem Content="百度翻译" />
                        <ComboBoxItem Content="DeepL" />
                        <ComboBoxItem Content="Google Translate" />
                    </ComboBox>
                    <TextBox x:Name="TranslateInputBox"
                             Grid.Column="1"
                             ToolTip="输入中文或英文；按钮会复制原文并打开内嵌翻译网站" />
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="8,0,0,0">
                        <Button Content="打开翻译" Click="OpenTranslate_Click" />
                        <Button Content="中 → 英" Click="TranslateZhToEn_Click" />
                        <Button Content="英 → 中" Click="TranslateEnToZh_Click" />
                        <Button Content="复制原文" Click="CopyTranslateInput_Click" />
                        <Button Content="清空" Click="ClearTranslateInput_Click" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <Grid Grid.Row="2"
              Margin="5"
              Visibility="{Binding IsDumpViewerPageVisible, Converter={StaticResource BoolToVisibilityConverter}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300" MinWidth="250" />
                <ColumnDefinition Width="5" />
                <ColumnDefinition Width="1.05*" MinWidth="360" />
                <ColumnDefinition Width="5" />
                <ColumnDefinition Width="1.55*" MinWidth="420" />
            </Grid.ColumnDefinitions>

            <GroupBox Grid.Column="0" Header="包列表 / Packet List">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0">
                        <TextBlock Text="过滤" Style="{StaticResource SectionTitle}" />
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="76" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="MsgID:" VerticalAlignment="Center" Margin="0,0,8,8" />
                            <TextBox Grid.Row="0"
                                     Grid.Column="1"
                                     Margin="0,0,0,8"
                                     Text="{Binding MsgIdFilter, UpdateSourceTrigger=PropertyChanged}" />

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Direction:" VerticalAlignment="Center" Margin="0,0,8,8" />
                            <ComboBox Grid.Row="1"
                                      Grid.Column="1"
                                      Margin="0,0,0,8"
                                      ItemsSource="{Binding DirectionOptions}"
                                      SelectedItem="{Binding SelectedDirection}" />

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Min Len:" VerticalAlignment="Center" Margin="0,0,8,8" />
                            <TextBox Grid.Row="2"
                                     Grid.Column="1"
                                     Margin="0,0,0,8"
                                     Text="{Binding MinLengthFilter, UpdateSourceTrigger=PropertyChanged}" />
                        </Grid>
                    </StackPanel>

                    <Separator Grid.Row="1" Margin="0,8" />

                    <ListBox Grid.Row="2"
                             ItemsSource="{Binding Packets}"
                             SelectedItem="{Binding SelectedPacket}"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             VirtualizingPanel.IsVirtualizing="True"
                             VirtualizingPanel.VirtualizationMode="Recycling">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="#E5E7EB"
                                        BorderThickness="0,0,0,1"
                                        Padding="8"
                                        ToolTip="{Binding DirectionDisplay}">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Row="0"
                                                   Grid.Column="0"
                                                   Text="{Binding SeqDisplay, StringFormat={}#{0}}"
                                                   FontWeight="Bold"
                                                   FontSize="15"
                                                   Margin="0,0,8,0" />
                                        <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal">
                                            <TextBlock Text="MsgID " />
                                            <TextBlock Text="{Binding MsgIdDisplay}" FontWeight="SemiBold" />
                                            <TextBlock Text="  " />
                                            <TextBlock Text="{Binding MsgRoleDisplay}"
                                                       TextTrimming="CharacterEllipsis"
                                                       Foreground="#374151" />
                                        </StackPanel>
                                        <TextBlock Grid.Row="0"
                                                   Grid.Column="2"
                                                   Text="{Binding LengthDisplay}"
                                                   Foreground="#6B7280"
                                                   Margin="8,0,0,0" />
                                        <StackPanel Grid.Row="1"
                                                    Grid.Column="1"
                                                    Grid.ColumnSpan="2"
                                                    Orientation="Horizontal"
                                                    Margin="0,3,0,0">
                                            <TextBlock Text="{Binding FlowDisplay}" Foreground="#2563EB" />
                                            <TextBlock Text="  ·  " Foreground="#9CA3AF" />
                                            <TextBlock Text="{Binding DirectionShortDisplay}"
                                                       Style="{StaticResource MutedText}"
                                                       TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </GroupBox>

            <GridSplitter Grid.Column="1"
                          Width="5"
                          HorizontalAlignment="Stretch"
                          Background="#E5E7EB" />

            <GroupBox Grid.Column="2" Header="Packet Detail / 封包详情">
                <TabControl>
                    <TabItem Header="详情 Detail">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="4">
                                <TextBlock Text="File" Style="{StaticResource SectionTitle}" />
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="92" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="seq:" FontWeight="SemiBold" />
                                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding SelectedPacket.SeqDisplay}" Style="{StaticResource MonoText}" />
                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="msgId:" FontWeight="SemiBold" />
                                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SelectedPacket.MsgIdDisplay}" Style="{StaticResource MonoText}" />
                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="name:" FontWeight="SemiBold" />
                                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding SelectedPacket.MsgRoleDisplay}" TextWrapping="Wrap" Style="{StaticResource MonoText}" />
                                    <TextBlock Grid.Row="3" Grid.Column="0" Text="direction:" FontWeight="SemiBold" />
                                    <StackPanel Grid.Row="3" Grid.Column="1">
                                        <TextBlock Text="{Binding SelectedPacket.DirectionDisplay}" TextWrapping="Wrap" Style="{StaticResource MonoText}" />
                                        <TextBlock Text="{Binding SelectedPacket.FlowDisplay}" Foreground="#2563EB" />
                                    </StackPanel>
                                    <TextBlock Grid.Row="4" Grid.Column="0" Text="length:" FontWeight="SemiBold" />
                                    <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding SelectedPacket.LengthDisplay}" Style="{StaticResource MonoText}" />
                                    <TextBlock Grid.Row="5" Grid.Column="0" Text="file size:" FontWeight="SemiBold" />
                                    <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding SelectedPacket.FileSizeDisplay}" Style="{StaticResource MonoText}" />
                                    <TextBlock Grid.Row="6" Grid.Column="0" Text="status:" FontWeight="SemiBold" />
                                    <TextBlock Grid.Row="6" Grid.Column="1" Text="{Binding SelectedPacket.StatusDisplay}" Style="{StaticResource MonoText}" />
                                    <TextBlock Grid.Row="7" Grid.Column="0" Text="path:" FontWeight="SemiBold" />
                                    <TextBlock Grid.Row="7" Grid.Column="1" Text="{Binding SelectedPacket.RelativePath}" TextWrapping="Wrap" Style="{StaticResource MonoText}" />
                                </Grid>

                                <Separator Margin="0,8" />

                                <DockPanel Margin="0,0,0,8">
                                    <TextBlock Text="Parser" Style="{StaticResource SectionTitle}" DockPanel.Dock="Left" />
                                    <Button Content="对照同级dump"
                                            Command="{Binding CompareSiblingDumpsCommand}"
                                            DockPanel.Dock="Right"
                                            HorizontalAlignment="Right"
                                            Padding="8,4" />
                                </DockPanel>
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="92" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="status:" FontWeight="SemiBold" />
                                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding ParserStatusText}" Style="{StaticResource MonoText}" />
                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="note:" FontWeight="SemiBold" />
                                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding ParserNoteText}" TextWrapping="Wrap" />
                                </Grid>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <TabItem Header="结构 Structure">
                        <Grid Margin="4">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <TextBlock Text="Msg100 / parser structure tree" Style="{StaticResource SectionTitle}" />
                            <Border Grid.Row="1" Background="#F9FAFB" BorderBrush="#E5E7EB" BorderThickness="1" Padding="10">
                                <TreeView ItemsSource="{Binding StructureNodes}"
                                          Background="#F9FAFB"
                                          BorderThickness="0"
                                          FontFamily="Consolas"
                                          VirtualizingPanel.IsVirtualizing="True"
                                          VirtualizingPanel.VirtualizationMode="Recycling" />
                            </Border>
                        </Grid>
                    </TabItem>

                    <TabItem Header="对照 Compare">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="4">
                                <DockPanel Margin="0,0,0,8">
                                    <TextBlock Text="Multi-dump comparison" Style="{StaticResource SectionTitle}" DockPanel.Dock="Left" />
                                    <Button Content="对照同级dump"
                                            Command="{Binding CompareSiblingDumpsCommand}"
                                            DockPanel.Dock="Right"
                                            HorizontalAlignment="Right"
                                            Padding="8,4" />
                                </DockPanel>
                                <TextBlock Text="{Binding ParserStatusText}" Style="{StaticResource MonoText}" />
                                <TextBlock Text="{Binding ParserNoteText}" TextWrapping="Wrap" Margin="0,8,0,0" />
                                <Separator Margin="0,12" />
                                <TextBlock Text="说明：Verified / Dynamic / UnknownName / Unaligned / Reserved 仍在结构树里显示；本页用于放大查看对照状态。" TextWrapping="Wrap" />
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>
                </TabControl>
            </GroupBox>

            <GridSplitter Grid.Column="3"
                          Width="5"
                          HorizontalAlignment="Stretch"
                          Background="#E5E7EB" />

            <GroupBox Grid.Column="4" Header="Hex / 翻译">
                <TabControl x:Name="RightTabs">
                    <TabItem Header="Hex View / 十六进制">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <DataGrid Grid.Row="0"
                                      ItemsSource="{Binding HexRows}"
                                      AutoGenerateColumns="False"
                                      CanUserAddRows="False"
                                      CanUserDeleteRows="False"
                                      IsReadOnly="True"
                                      HeadersVisibility="Column"
                                      GridLinesVisibility="Horizontal"
                                      FontFamily="Consolas"
                                      FontSize="13"
                                      EnableRowVirtualization="True">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Offset" Binding="{Binding Offset}" Width="100" />
                                    <DataGridTextColumn Header="Hex Bytes" Binding="{Binding HexBytes}" Width="*" />
                                    <DataGridTextColumn Header="ASCII" Binding="{Binding Ascii}" Width="150" />
                                </DataGrid.Columns>
                            </DataGrid>

                            <DockPanel Grid.Row="1" Margin="0,10,0,0" LastChildFill="False">
                                <TextBlock Text="{Binding CurrentRangeText}" VerticalAlignment="Center" Margin="0,0,18,0" />
                                <Button Content="上一页" Command="{Binding PreviousPageCommand}" />
                                <Button Content="下一页" Command="{Binding NextPageCommand}" />
                                <TextBlock Text="跳转Offset:" VerticalAlignment="Center" Margin="14,0,6,0" />
                                <TextBox Text="{Binding JumpOffsetText, UpdateSourceTrigger=PropertyChanged}" Width="110" FontFamily="Consolas" />
                                <Button Content="跳转" Command="{Binding JumpOffsetCommand}" />
                            </DockPanel>
                        </Grid>
                    </TabItem>

                    <TabItem x:Name="TranslateTab" Header="翻译 Translate">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <TextBlock Text="内嵌翻译网页：不接 API，不解析网页结果；自动复制原文，页面变化时可手动粘贴。"
                                       Style="{StaticResource MutedText}"
                                       Margin="4,4,4,8" />
                            <Border Grid.Row="1" BorderBrush="#D1D5DB" BorderThickness="1" Background="White">
                                <wv2:WebView2 x:Name="TranslateWebView"
                                              DefaultBackgroundColor="White" />
                            </Border>
                        </Grid>
                    </TabItem>
                </TabControl>
            </GroupBox>
        </Grid>

        <Grid Grid.Row="2"
              Margin="5"
              Visibility="{Binding IsWiresharkDecryptPageVisible, Converter={StaticResource BoolToVisibilityConverter}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="5" />
                <RowDefinition Height="2.0*" MinHeight="260" />
                <RowDefinition Height="5" />
                <RowDefinition Height="1.65*" MinHeight="260" />
            </Grid.RowDefinitions>

            <GroupBox Grid.Row="0" Header="在线抓包控制 / Online Capture Control">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="1.0*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="1.0*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="进程:" VerticalAlignment="Center" Margin="0,0,8,8" />
                    <TextBox Grid.Row="0"
                             Grid.Column="1"
                             Text="{Binding OnlineProcessName, UpdateSourceTrigger=PropertyChanged}"
                             FontFamily="Consolas"
                             Margin="0,0,12,8" />
                    <TextBlock Grid.Row="0" Grid.Column="2" Text="引擎:" VerticalAlignment="Center" Margin="0,0,8,8" />
                    <ComboBox Grid.Row="0"
                             Grid.Column="3"
                             ItemsSource="{Binding OnlineCaptureEngineOptions}"
                             SelectedItem="{Binding OnlineCaptureEngine, UpdateSourceTrigger=PropertyChanged}"
                             Margin="0,0,12,8" />
                    <TextBlock Grid.Row="1" Grid.Column="0" Text="网卡:" VerticalAlignment="Center" Margin="0,0,8,8" />
                    <TextBox Grid.Row="1"
                             Grid.Column="1"
                             Grid.ColumnSpan="3"
                             Text="{Binding OnlineAdapterName, UpdateSourceTrigger=PropertyChanged}"
                             Margin="0,0,12,8" />
                    <StackPanel Grid.Row="0" Grid.RowSpan="3" Grid.Column="4" Orientation="Horizontal" Margin="0,0,0,8">
                        <Button Content="刷新进程" Command="{Binding RefreshOnlineProcessCommand}" />
                        <Button Content="启动/注入/抓包"
                                Command="{Binding StartOnlineCaptureCommand}"
                                Background="#2563EB"
                                Foreground="White"
                                MinWidth="120" />
                        <Button Content="停止" Command="{Binding StopOnlineCaptureCommand}" />
                        <Button Content="清空" Command="{Binding ClearOnlineCaptureCommand}" />
                        <Button Content="导出JSON" Command="{Binding ExportOnlineCaptureJsonCommand}" />
                        <Button Content="返回Dump" Command="{Binding ShowDumpViewerCommand}" />
                    </StackPanel>

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="登陆器:" VerticalAlignment="Center" Margin="0,0,8,8" />
                    <TextBox Grid.Row="2"
                             Grid.Column="1"
                             Text="{Binding OnlineLauncherPath, UpdateSourceTrigger=PropertyChanged}"
                             FontFamily="Consolas"
                             ToolTip="选择 QQSpeedLauncher.exe 或你实际使用的 s30.exe；Viewer 会像 PacketDumpLauncher 一样启动它，新 GameApp.exe 出现后立即注入。"
                             Margin="0,0,8,8" />
                    <Button Grid.Row="2"
                            Grid.Column="2"
                            Content="选择登陆器"
                            Command="{Binding SelectOnlineLauncherCommand}"
                            Margin="0,0,12,8" />
                    <ComboBox Grid.Row="2"
                              Grid.Column="3"
                              ItemsSource="{Binding OnlineInjectionModeOptions}"
                              SelectedItem="{Binding OnlineInjectionMode, UpdateSourceTrigger=PropertyChanged}"
                              ToolTip="默认与 PacketDumpLauncher 当前命令一致：新 GameApp.exe 出现立即注入。"
                              Margin="0,0,12,8" />

                    <TextBlock Grid.Row="3"
                               Grid.Column="0"
                               Text="状态:"
                               VerticalAlignment="Center"
                               Margin="0,0,8,8" />
                    <WrapPanel Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="4" Margin="0,0,0,8">
                        <Border Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1" Padding="8,4" Margin="0,0,8,6">
                            <TextBlock Text="{Binding OnlineCaptureStatus}" />
                        </Border>
                        <Border Background="#FFF7ED" BorderBrush="#FDBA74" BorderThickness="1" Padding="8,4" Margin="0,0,8,6">
                            <TextBlock Text="{Binding OnlineLauncherInjectionStatus}" />
                        </Border>
                        <Border Background="#F0FDF4" BorderBrush="#BBF7D0" BorderThickness="1" Padding="8,4" Margin="0,0,8,6">
                            <TextBlock Text="{Binding OnlineCaptureEngineStatus}" />
                        </Border>
                        <Border Background="#EEF2FF" BorderBrush="#A5B4FC" BorderThickness="1" Padding="8,4" Margin="0,0,8,6">
                            <TextBlock Text="{Binding OnlineKeyProbeStatus}" />
                        </Border>
                        <Border Background="#F9FAFB" BorderBrush="#D1D5DB" BorderThickness="1" Padding="8,4" Margin="0,0,8,6">
                            <TextBlock Text="{Binding OnlineBackendStatus}" />
                        </Border>
                        <Border Background="#F9FAFB" BorderBrush="#D1D5DB" BorderThickness="1" Padding="8,4" Margin="0,0,8,6">
                            <TextBlock Text="{Binding OnlinePacketsCountText}" />
                        </Border>
                    </WrapPanel>

                    <Expander Grid.Row="4"
                              Grid.Column="0"
                              Grid.ColumnSpan="5"
                              Header="KeyProbe / 自写Hook"
                              IsExpanded="False">
                        <Grid Margin="0,10,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="1.0*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="1.0*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Key状态:" VerticalAlignment="Center" Margin="0,0,8,8" />
                            <Button Grid.Row="0"
                                    Grid.Column="1"
                                    Content="刷新Hook状态"
                                    Command="{Binding RefreshOnlineProcessCommand}"
                                    HorizontalAlignment="Left"
                                    Margin="0,0,16,8" />
                            <TextBlock Grid.Row="0"
                                       Grid.Column="2"
                                       Grid.ColumnSpan="2"
                                       Text="{Binding WiresharkSessionKeyStatus, Mode=OneWay}"
                                       Foreground="#2563EB"
                                       VerticalAlignment="Center"
                                       Margin="0,0,8,8" />
                            <TextBox Grid.Row="0"
                                     Grid.Column="4"
                                     Grid.ColumnSpan="2"
                                     Text="{Binding WiresharkSessionKeyAscii, Mode=OneWay}"
                                     IsReadOnly="True"
                                     FontFamily="Consolas"
                                     Margin="0,0,0,8" />

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="工作目录:" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <TextBox Grid.Row="1"
                                     Grid.Column="1"
                                     Text="{Binding OnlineLauncherWorkDirectory, UpdateSourceTrigger=PropertyChanged}"
                                     FontFamily="Consolas"
                                     ToolTip="默认等于登陆器所在目录，对齐 PacketDumpLauncher --workdir。"
                                     Margin="0,0,8,0" />
                            <TextBlock Grid.Row="1" Grid.Column="2" Text="参数:" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <TextBox Grid.Row="1"
                                     Grid.Column="3"
                                     Text="{Binding OnlineLauncherArguments, UpdateSourceTrigger=PropertyChanged}"
                                     FontFamily="Consolas"
                                     ToolTip="可选：传给登陆器的命令行参数，对齐 PacketDumpLauncher --args。"
                                     Margin="0,0,8,0" />
                            <TextBlock Grid.Row="1" Grid.Column="4" Text="等待模块:" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <TextBox Grid.Row="1"
                                     Grid.Column="5"
                                     Text="{Binding OnlineModuleName, UpdateSourceTrigger=PropertyChanged}"
                                     FontFamily="Consolas"
                                     ToolTip="只有选择“等待Network.dll后注入”时使用；默认 Network.dll。" />

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Session Key Hex:" VerticalAlignment="Center" Margin="0,8,8,0" />
                            <TextBox Grid.Row="2"
                                     Grid.Column="1"
                                     Grid.ColumnSpan="4"
                                     Text="{Binding WiresharkSessionKeyHex, UpdateSourceTrigger=PropertyChanged}"
                                     FontFamily="Consolas"
                                     Margin="0,8,8,0"
                                     ToolTip="这里显示/粘贴当前登录态 session key，格式为 16 bytes hex，例如 AA BB CC ..." />
                            <StackPanel Grid.Row="2" Grid.Column="5" Orientation="Horizontal" Margin="0,8,0,0">
                                <Button Content="复制Key"
                                        Command="{Binding CopyWiresharkSessionKeyCommand}" />
                                <Button Content="保存Key"
                                        Command="{Binding SaveWiresharkSessionKeyCommand}" />
                                <Button Content="清空"
                                        Command="{Binding ClearWiresharkSessionKeyCommand}" />
                            </StackPanel>

                            <TextBlock Grid.Row="3"
                                       Grid.Column="0"
                                       Grid.ColumnSpan="6"
                                       Text="说明：旧离线自动提 key 入口已移除；后续由自写 key_probe.dll 在 GameApp/Network 运行态验证并填入 Session Key。"
                                       Style="{StaticResource MutedText}"
                                       TextWrapping="Wrap"
                                       Margin="0,8,0,0" />
                        </Grid>
                    </Expander>
                </Grid>
            </GroupBox>

            <GridSplitter Grid.Row="1"
                          Height="5"
                          HorizontalAlignment="Stretch"
                          Background="#E5E7EB" />

            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.65*" MinWidth="660" />
                    <ColumnDefinition Width="5" />
                    <ColumnDefinition Width="0.85*" MinWidth="360" />
                </Grid.ColumnDefinitions>

                <GroupBox Grid.Column="0" Header="Network明文包列表 / Network Plain Packets">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="160" />
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="190" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="MsgID搜索:" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <TextBox Grid.Column="1"
                                     Text="{Binding OnlinePacketMsgIdSearch, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="输入 28346 / 100 / 223 等 MsgID 过滤在线包" />
                            <TextBlock Grid.Column="3" Text="排序:" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <ComboBox Grid.Column="4"
                                      ItemsSource="{Binding OnlinePacketSortOptions}"
                                      SelectedItem="{Binding OnlinePacketSortOrder, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Grid.Column="5"
                                       Text="Top-Kart 包已分到右侧；中间态自动隐藏；body 表示该阶段没有 MSGHEAD"
                                       Style="{StaticResource MutedText}"
                                       VerticalAlignment="Center"
                                       Margin="12,0,0,0" />
                        </Grid>

                        <DataGrid Grid.Row="1"
                                  ItemsSource="{Binding WiresharkPacketRows}"
                                  SelectedItem="{Binding SelectedWiresharkPacketRow, Mode=TwoWay}"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  CanUserDeleteRows="False"
                                  CanUserSortColumns="True"
                                  IsReadOnly="True"
                                  HeadersVisibility="Column"
                                  GridLinesVisibility="Horizontal"
                                  FontFamily="Consolas"
                                  FontSize="13"
                                  EnableRowVirtualization="True">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="包序列" Binding="{Binding PacketIndex}" SortMemberPath="PacketIndexNumber" Width="76" />
                                <DataGridTextColumn Header="方向" Binding="{Binding Direction}" Width="86" />
                                <DataGridTextColumn Header="msgid" Binding="{Binding MsgId}" Width="112" />
                                <DataGridTextColumn Header="msgtype" Binding="{Binding MsgType}" Width="80" />
                                <DataGridTextColumn Header="MsgSeq" Binding="{Binding MsgSeq}" Width="88" />
                                <DataGridTextColumn Header="BodyLen" Binding="{Binding BodyLen}" Width="88" />
                                <DataGridTextColumn Header="长度" Binding="{Binding Length}" Width="86" />
                                <DataGridTextColumn Header="来源/阶段" Binding="{Binding Function}" Width="*" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </GroupBox>

                <GridSplitter Grid.Column="1"
                              Width="5"
                              HorizontalAlignment="Stretch"
                              Background="#E5E7EB" />

                <GroupBox Grid.Column="2" Header="Top-Kart Hook / Top包">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="96" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0"
                                   Text="{Binding OnlineTopKartHookStatus}"
                                   FontWeight="SemiBold"
                                   Foreground="#0E7490"
                                   TextWrapping="Wrap" />
                        <TextBlock Grid.Row="1"
                                   Text="{Binding WiresharkStatusText}"
                                   Foreground="#2563EB"
                                   TextWrapping="Wrap"
                                   Margin="0,10,0,0" />
                        <TextBlock Grid.Row="2"
                                   Text="这里专门显示 Top-Kart.dll RequestGameServer source object 包；点击 Top 包后，下方 HEX/Structure 跟随刷新。"
                                   Style="{StaticResource MutedText}"
                                   TextWrapping="Wrap"
                                   Margin="0,8,0,12" />
                        <DataGrid Grid.Row="3"
                                  ItemsSource="{Binding TopKartPacketRows}"
                                  SelectedItem="{Binding SelectedTopKartPacketRow, Mode=TwoWay}"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  CanUserDeleteRows="False"
                                  CanUserSortColumns="True"
                                  IsReadOnly="True"
                                  HeadersVisibility="Column"
                                  GridLinesVisibility="Horizontal"
                                  FontFamily="Consolas"
                                  FontSize="12"
                                  EnableRowVirtualization="True">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="序列" Binding="{Binding PacketIndex}" SortMemberPath="PacketIndexNumber" Width="58" />
                                <DataGridTextColumn Header="方向" Binding="{Binding Direction}" Width="72" />
                                <DataGridTextColumn Header="msgid" Binding="{Binding MsgId}" Width="64" />
                                <DataGridTextColumn Header="预览" Binding="{Binding Length}" Width="104" />
                                <DataGridTextColumn Header="Top功能" Binding="{Binding Function}" Width="*" />
                            </DataGrid.Columns>
                        </DataGrid>
                        <TextBox Grid.Row="4"
                                 Text="{Binding SelectedTopKartPacketText}"
                                 IsReadOnly="True"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto"
                                 HorizontalScrollBarVisibility="Auto"
                                 FontFamily="Consolas"
                                 FontSize="12"
                                 Background="#F9FAFB"
                                 BorderBrush="#E5E7EB"
                                 Margin="0,8,0,0" />
                    </Grid>
                </GroupBox>
            </Grid>

            <GridSplitter Grid.Row="3"
                          Height="5"
                          HorizontalAlignment="Stretch"
                          Background="#E5E7EB" />

            <Grid Grid.Row="4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.12*" MinWidth="520" />
                    <ColumnDefinition Width="5" />
                    <ColumnDefinition Width="1.28*" MinWidth="560" />
                </Grid.ColumnDefinitions>

                <GroupBox Grid.Column="0" Header="结构体 / Structure Tree">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0"
                                   Text="{Binding WiresharkStructureText}"
                                   TextWrapping="Wrap"
                                   FontFamily="Consolas"
                                   Foreground="#374151"
                                   MaxHeight="52"
                                   Margin="0,0,0,6" />

                        <TreeView Grid.Row="1"
                                  ItemsSource="{Binding OnlineStructureNodes}"
                                  Background="#F9FAFB"
                                  BorderThickness="0"
                                  FontFamily="Consolas"
                                  VirtualizingPanel.IsVirtualizing="False" />
                    </Grid>
                </GroupBox>

                <GridSplitter Grid.Column="1"
                              Width="5"
                              HorizontalAlignment="Stretch"
                              Background="#E5E7EB" />

                <GroupBox Grid.Column="2" Header="HEX / Hex View">
                    <TextBox Text="{Binding WiresharkDecryptedHexText}"
                             IsReadOnly="True"
                             AcceptsReturn="True"
                             TextWrapping="NoWrap"
                             VerticalScrollBarVisibility="Auto"
                             HorizontalScrollBarVisibility="Auto"
                             FontFamily="Consolas"
                             Background="#F9FAFB"
                             Foreground="#111827"
                             BorderThickness="0" />
                </GroupBox>
            </Grid>
        </Grid>

        <Border Grid.Row="3"
                Background="#F8FAFC"
                BorderBrush="#C7CFDA"
                BorderThickness="0,1,0,0"
                Padding="7,5">
            <TextBlock Text="{Binding StatusText}" Foreground="#374151" />
        </Border>
    </Grid>
</Window>
