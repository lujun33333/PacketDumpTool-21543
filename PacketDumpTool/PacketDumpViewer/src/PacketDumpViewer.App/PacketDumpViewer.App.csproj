<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <AssemblyName>PacketDumpViewer</AssemblyName>
    <PlatformTarget>x64</PlatformTarget>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4022.49" />
    <PackageReference Include="PacketDotNet" Version="1.4.8" />
    <PackageReference Include="SharpPcap" Version="6.3.1" />
    <PackageReference Include="System.Text.Encoding.CodePages" Version="9.0.6" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="native\*.dll" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\native\key_probe\x64\Release\key_probe.dll"
             Link="native_src\key_probe.dll"
             CopyToOutputDirectory="PreserveNewest"
             Condition="Exists('..\..\native\key_probe\x64\Release\key_probe.dll')" />
  </ItemGroup>

</Project>
